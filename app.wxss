/* ============================================================
   全局样式 · MES 现场知识问答
   配色：主色 #0f62c4（图纸蓝） / 底色 #f2f5f9 / 正文 #12202e
   ============================================================ */

page {
  background: #f2f5f9;
  color: #12202e;
  font-size: 30rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 自定义导航栏 ---------- */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: #0f62c4;
}
.nav-inner {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
}
.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  pointer-events: none;
}
.nav-btn {
  position: absolute;
  right: 0;
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}
.nav-btn text {
  font-size: 24rpx;
  color: #fff;
  margin-left: 8rpx;
}
.nav-btn .i { width: 28rpx; height: 28rpx; }

