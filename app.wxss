/* ---------- 通用卡片 ---------- */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin: 0 24rpx 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 36, 64, 0.06);
}
.h2 {
  font-size: 30rpx;
  font-weight: 700;
  color: #12202e;
  margin-bottom: 14rpx;
}
.text { font-size: 29rpx; line-height: 1.75; color: #33475c; }
.quiet { color: #8a97a8; }

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}
.tag-code { background: #eef2f7; color: #6b7d90; }
.tag-ind { background: #eaf2fd; color: #0f62c4; }
.tag-mod { background: #f2f7ee; color: #10884f; }

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 2.6;
  padding: 0 26rpx;
  margin: 0;
}
.btn::after { border: none; }
